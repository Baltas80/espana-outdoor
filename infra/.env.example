# Never commit real credentials. Copy to .env locally.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

OIDC_ISSUER=http://keycloak:8080/realms/espana-outdoor
OIDC_AUDIENCE=espana-outdoors-mobile
PUBLIC_SHARE_BASE_URL=https://rescue.example.com
LOCATION_ENCRYPTION_KEY=SET_IN_SECRET_MANAGER

AEMET_API_KEY=change-me
AEMET_API_KEY_EXPIRES_AT=2026-10-15T00:00:00Z

VALHALLA_TILE_URLS=
MAP_PMTILES_URL=

# Shared app + website profile API
PROFILE_OIDC_ISSUER=https://auth.espanaoutdoor.es/realms/espana-outdoor
PROFILE_OIDC_AUDIENCE=espana-outdoor-api
PROFILE_CORS_ALLOWED_ORIGINS=https://espanaoutdoor.es,https://www.espanaoutdoor.es
