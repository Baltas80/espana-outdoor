# Never commit real credentials. Copy to .env locally.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Local Docker Compose only. Set false in production and use public HTTPS OIDC/PostgreSQL.
ALLOW_HTTP_DEV=true
# Must use the same password as POSTGRES_PASSWORD; encode reserved URL characters.
DATABASE_URL=postgresql://espana:change-me@postgres:5432/espana_outdoor?sslmode=disable

OIDC_ISSUER=http://keycloak:8080/realms/espana-outdoor
# Dedicated resource-server audience; distinct from the public web/mobile client ID.
OIDC_AUDIENCE=espana-outdoors-api
OIDC_REQUIRED_ROLE=source.read
# Dedicated Rescue Link resource-server audience. Configure a Keycloak audience mapper on access tokens.
RESCUE_LINK_OIDC_AUDIENCE=espana-outdoors-rescue-api
PUBLIC_SHARE_BASE_URL=https://rescue.example.com
LOCATION_ENCRYPTION_KEY=

AEMET_API_KEY=change-me
# Replace with the actual expiry supplied by AEMET before starting the gateway.
AEMET_API_KEY_EXPIRES_AT=2099-12-31T23:59:59Z

VALHALLA_TILE_URLS=
MAP_PMTILES_URL=
