# Production endpoint contract for España Outdoor.
# Copy to a deployment secret store; never commit real credentials.
# All public endpoints MUST use HTTPS.
# Source Gateway also serves the canonical shared-profile API.
# The static web account page and Android COMMUNITY_API_BASE_URL must target
# this same public HTTPS origin.
SOURCE_GATEWAY_BASE_URL=https://api.espanaoutdoor.es
COMMUNITY_API_BASE_URL=https://api.espanaoutdoor.es

# Public clients; never put a client secret in the web bundle or APK.
OIDC_WEB_CLIENT_ID=espana-outdoors-web
OIDC_CLIENT_ID=espana-outdoors-mobile
OIDC_REDIRECT_URI=com.espanaoutdoors://oauth2redirect
OIDC_AUDIENCE=espana-outdoors-api
OIDC_REQUIRED_ROLE=source.read
RESCUE_LINK_OIDC_AUDIENCE=espana-outdoors-rescue-api


MAP_PMTILES_URL=https://maps.example.com/spain.pmtiles
VALHALLA_BASE_URL=https://routing.example.com
LIVE_DATA_BASE_URL=https://live.example.com
RESCUE_LINK_BASE_URL=https://rescue.example.com
KEYCLOAK_HOSTNAME=https://auth.espanaoutdoor.es
KEYCLOAK_PROXY_HEADERS=xforwarded
# This exact variable is consumed by Source Gateway and must equal Keycloak discovery's issuer.
OIDC_ISSUER=https://auth.espanaoutdoor.es/realms/espana-outdoor

# Required before production gate:
# - Replace every example.com value with the real controlled endpoint.
# - Verify HTTP 200/healthy responses from an external network.
# - Verify PMTiles supports HTTP Range requests and checksum validation.
# - Verify Valhalla serves Spain pedestrian routes and elevation where configured.
# - Verify Live Data uses real OIDC/AEMET runtime credentials.
# - Verify Rescue Link uses production TLS, OIDC and encrypted storage.
