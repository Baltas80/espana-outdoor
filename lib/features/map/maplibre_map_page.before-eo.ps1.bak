import 'package:flutter/material.dart';
import 'package:maplibre_gl/maplibre_gl.dart';

/// Pantalla cartográfica de España Outdoor.
/// El proveedor de mapas y la interfaz se mantienen desacoplados.
class MapLibreMapPage extends StatefulWidget {
  const MapLibreMapPage({super.key});

  @override
  State<MapLibreMapPage> createState() => _MapLibreMapPageState();
}

class _MapLibreMapPageState extends State<MapLibreMapPage> {
  MapLibreMapController? _controller;
  bool _styleLoaded = false;

  void _onMapCreated(MapLibreMapController controller) {
    _controller = controller;
  }

  void _onStyleLoaded() {
    if (!mounted) return;
    setState(() => _styleLoaded = true);
  }

  Future<void> _recenter() async {
    await _controller?.animateCamera(
      CameraUpdate.newCameraPosition(
        const CameraPosition(
          target: LatLng(40.4168, -3.7038),
          zoom: 5.5,
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Mapa'),
        actions: [
          IconButton(
            tooltip: 'Volver a la vista inicial',
            onPressed: _recenter,
            icon: const Icon(Icons.center_focus_strong),
          ),
        ],
      ),
      body: Stack(
        children: [
          Positioned.fill(
            child: MapLibreMap(
              initialCameraPosition: const CameraPosition(
                target: LatLng(40.4168, -3.7038),
                zoom: 5.5,
              ),
              styleString: 'https://demotiles.maplibre.org/style.json',
              onMapCreated: _onMapCreated,
              onStyleLoadedCallback: _onStyleLoaded,
              compassEnabled: true,
              rotateGesturesEnabled: true,
              scrollGesturesEnabled: true,
              zoomGesturesEnabled: true,
              tiltGesturesEnabled: false,
              myLocationEnabled: false,
            ),
          ),
          if (!_styleLoaded)
            const Positioned(
              left: 0,
              right: 0,
              top: 0,
              child: LinearProgressIndicator(),
            ),
        ],
      ),
    );
  }
}
